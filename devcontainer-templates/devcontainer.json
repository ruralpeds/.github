{
  "name": "ruralpeds dev",
  // Generated by ruralpeds/.github reusable-devcontainer workflow.
  // To opt this file out of future syncs, add: AUTO-SYNC-OPT-OUT anywhere here.

  // Base image: Ubuntu 24.04 LTS (jammy successor).
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // ── Language feature set ───────────────────────────────────────────────────
  // Each feature is pinned to a major version tag; Dependabot keeps these
  // current. Remove features not used in your repo to keep build time short.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "nvmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.23"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "default"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    }
  },

  // ── Post-create: installs Claude Code CLI and org tooling ──────────────────
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // ── VS Code customizations ─────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        // Rust
        "rust-lang.rust-analyzer",
        // Julia
        "julialang.language-julia",
        // Go
        "golang.go",
        // Web / formatting
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        // GitHub Actions authoring
        "github.vscode-github-actions",
        // YAML + JSON
        "redhat.vscode-yaml",
        "zxh404.vscode-proto3"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [120, 160],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  },

  // ── Environment: pass ANTHROPIC_API_KEY from host to container ─────────────
  // Set ANTHROPIC_API_KEY in your local shell / .env.local; it will be
  // forwarded automatically when the container starts.
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  // ── Container capabilities ─────────────────────────────────────────────────
  // Keep these minimal. Expand only when a specific tool requires it.
  "runArgs": [],
  "mounts": []
}
