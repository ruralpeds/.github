# Dependencies
node_modules/
target/
# wasm-pkg is built by CI and committed to the repo (see .github/workflows/build-wasm.yml)
# so it is NOT ignored here. To rebuild locally:
#   wasm-pack build --target web --out-dir apps/web/wasm-pkg --release crates/ped-wasm

# Build output
apps/web/build/
apps/web/.svelte-kit/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Rust
Cargo.lock
*.rlib

# Environment
.env
.env.local

# Build pipeline — DOCX binaries in queue/done folders are not tracked;
# only the .gitkeep placeholders are committed.
build-queue/to-build/*.docx
build-queue/built/*.docx
add-education/incoming/*.docx
add-education/educational-material/*.docx
test-results/
