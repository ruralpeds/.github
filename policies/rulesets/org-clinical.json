{
  "name": "org-clinical",
  "description": "Enhanced rules for clinical-criticality repos (clinical-support, clinical-decision, device)",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "repository_property_targeting": {
      "include": {
        "repository_property": [
          {
            "property_name": "criticality",
            "property_values": [
              "clinical-support",
              "clinical-decision",
              "device"
            ]
          }
        ]
      }
    }
  },
  "rules": [
    {
      "type": "creation",
      "parameters": {
        "restriction": "non_empty"
      }
    },
    {
      "type": "required_signatures",
      "parameters": {
        "key_type_set": [
          "pgp",
          "ssh"
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_review_thread_resolution": true,
        "required_approving_review_count": 2,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "ci"
          },
          {
            "context": "PHI scan"
          },
          {
            "context": "SBOM"
          },
          {
            "context": "CodeQL"
          },
          {
            "context": "Scorecard"
          }
        ],
        "strict_required_status_checks_policy": true
      }
    },
    {
      "type": "restrict_pushes",
      "parameters": {
        "restrict_to": [
          "deploy_keys",
          "github_app"
        ]
      }
    },
    {
      "type": "non_fast_forward",
      "parameters": {}
    }
  ],
  "metadata": {
    "applies_to": "Repos where criticality ∈ {clinical-support, clinical-decision, device}",
    "min_reviewers": 2,
    "requires_signatures": true,
    "required_checks": [
      "ci",
      "PHI scan",
      "SBOM",
      "CodeQL",
      "Scorecard"
    ],
    "comment": "Enforces: 2 reviewers, signed commits, resolved review threads, all security checks passing, linear history (no force-push)"
  }
}
