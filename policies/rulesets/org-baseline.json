{
  "name": "org-baseline",
  "description": "Baseline security rules for all repositories (all criticality levels)",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "repository_property_targeting": {
      "exclude": {
        "repository_property": []
      },
      "include": {
        "repository_property": []
      }
    }
  },
  "rules": [
    {
      "type": "creation",
      "parameters": {
        "restriction": "non_empty"
      }
    },
    {
      "type": "update",
      "parameters": {
        "allowed_actors": [
          "repo_admin"
        ],
        "dismiss_stale_reviews": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_review_thread_resolution": false
      }
    },
    {
      "type": "deletion",
      "parameters": {
        "allowed_actors": [
          "repo_admin"
        ]
      }
    },
    {
      "type": "required_signatures",
      "parameters": {
        "key_type": "ssh",
        "key_type_set": [
          "pgp",
          "ssh"
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_review_thread_resolution": false,
        "required_approving_review_count": 1,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "lint"
          }
        ],
        "strict_required_status_checks_policy": true
      }
    },
    {
      "type": "restrict_pushes",
      "parameters": {
        "restrict_to": [
          "deploy_keys",
          "github_app"
        ],
        "push_allowances": []
      }
    }
  ],
  "metadata": {
    "applies_to": "All repositories (baseline)",
    "min_reviewers": 1,
    "requires_signatures": true,
    "comment": "Enforces: signed commits (SSH or GPG), PR review (≥1), code ownership review on demand, no force-push to default branch"
  }
}
