{
	"id": "pals-tachycardia-2025",
	"title": "PALS Tachycardia with Pulse",
	"version": "1.0",
	"mode": "pediatric",
	"source": "AHA PALS 2025 Guidelines",
	"lastUpdated": "2025-03",
	"root": {
		"id": "tachy-id",
		"label": "Tachycardia with Pulse",
		"type": "assessment",
		"description": "HR above age-appropriate norm. Evaluate QRS width.",
		"children": [
			{
				"label": "Evaluate QRS",
				"node": {
					"id": "qrs-width",
					"label": "QRS Width?",
					"type": "decision",
					"description": "Narrow (≤0.09s) vs Wide (>0.09s)",
					"panels": [
						{
							"label": "QRS Duration",
							"type": "table",
							"content": {
								"headers": [
									"QRS",
									"Likely Rhythm",
									"Approach"
								],
								"rows": [
									[
										"Narrow (≤0.09s)",
										"SVT or sinus tachycardia",
										"Differentiate SVT vs sinus"
									],
									[
										"Wide (>0.09s)",
										"VT until proven otherwise",
										"Treat as VT — safer assumption"
									]
								]
							}
						}
					],
					"children": [
						{
							"label": "Narrow QRS",
							"node": {
								"id": "narrow-qrs",
								"label": "SVT vs Sinus Tachycardia",
								"type": "decision",
								"description": "Rate variability? P waves? History?",
								"panels": [
									{
										"label": "Differentiation",
										"type": "table",
										"content": {
											"headers": [
												"Feature",
												"Sinus Tachycardia",
												"SVT"
											],
											"rows": [
												[
													"Rate",
													"Usually <220 infant, <180 child",
													"Usually >220 infant, >180 child"
												],
												[
													"P waves",
													"Present, normal axis",
													"Absent or retrograde"
												],
												[
													"Rate variability",
													"Varies with activity/stimulation",
													"Fixed rate (abrupt onset/offset)"
												],
												[
													"History",
													"Fever, pain, dehydration, anemia",
													"Sudden onset, may have hx of SVT"
												],
												[
													"R-R interval",
													"Variable",
													"Regular"
												]
											]
										}
									}
								],
								"children": [
									{
										"label": "Sinus tachycardia",
										"node": {
											"id": "sinus",
											"label": "Treat Underlying Cause",
											"type": "action",
											"description": "Fever, pain, dehydration, anemia, anxiety — treat the cause",
											"panels": [
												{
													"label": "Causes",
													"type": "list",
													"content": {
														"items": [
															"Fever (most common)",
															"Pain/agitation",
															"Dehydration/hypovolemia",
															"Anemia",
															"Medications/toxins",
															"Anxiety",
															"Sepsis/shock",
															"PE/pneumothorax"
														]
													}
												}
											]
										}
									},
									{
										"label": "SVT",
										"node": {
											"id": "svt",
											"label": "Hemodynamically Stable?",
											"type": "decision",
											"children": [
												{
													"label": "Stable",
													"node": {
														"id": "vagal",
														"label": "Vagal Maneuvers → Adenosine",
														"type": "action",
														"description": "Ice to face (infant) or Valsalva (older child), then adenosine",
														"wasmCompute": [
															{
																"fn": "calculateDose",
																"args": [
																	"adenosine"
																],
																"displayKey": "adenDose",
																"format": "dose"
															}
														],
														"panels": [
															{
																"label": "Vagal Maneuvers",
																"type": "list",
																"content": {
																	"items": [
																		"Infant: ice bag/cold wet washcloth to face for 15-20 sec",
																		"Older child: Valsalva (bear down, blow through straw, blow into syringe)",
																		"Do NOT apply ocular pressure",
																		"Record continuous rhythm strip during maneuvers"
																	]
																}
															},
															{
																"label": "Adenosine",
																"type": "table",
																"content": {
																	"headers": [
																		"Dose",
																		"Amount",
																		"Notes"
																	],
																	"rows": [
																		[
																			"1st dose",
																			"0.1 mg/kg (max 6 mg)",
																			"RAPID IV push → immediate 5-10 mL NS flush"
																		],
																		[
																			"2nd dose",
																			"0.2 mg/kg (max 12 mg)",
																			"If 1st dose fails, double the dose"
																		]
																	],
																	"caption": "Must be given as RAPID push with immediate saline flush. Closest port to heart."
																}
															}
														],
														"children": [
															{
																"label": "Converts",
																"node": {
																	"id": "svt-converted",
																	"label": "Rhythm Converted",
																	"type": "assessment",
																	"description": "Monitor for recurrence. Cardiology referral."
																}
															},
															{
																"label": "Fails",
																"node": {
																	"id": "svt-refractory",
																	"label": "Consider Cardioversion",
																	"type": "urgent",
																	"description": "Synchronized cardioversion 0.5-1 J/kg. Sedate first if stable."
																}
															}
														]
													}
												},
												{
													"label": "Unstable",
													"node": {
														"id": "svt-unstable",
														"label": "Synchronized Cardioversion",
														"type": "emergency",
														"description": "0.5-1 J/kg. Sedate if time permits. May try adenosine while preparing.",
														"panels": [
															{
																"label": "Protocol",
																"type": "list",
																"content": {
																	"items": [
																		"Synchronized cardioversion: 0.5-1 J/kg",
																		"If fails, increase to 2 J/kg",
																		"Sedate with ketamine or midazolam if time permits",
																		"May attempt adenosine while preparing for cardioversion",
																		"Record rhythm strip during and after",
																		"Have defibrillator ready in case of VF"
																	]
																}
															}
														]
													}
												}
											]
										}
									}
								]
							}
						},
						{
							"label": "Wide QRS",
							"node": {
								"id": "wide-qrs",
								"label": "Assume VT",
								"type": "emergency",
								"description": "Wide-complex tachycardia = VT until proven otherwise",
								"panels": [
									{
										"label": "VT Clues",
										"type": "list",
										"content": {
											"items": [
												"AV dissociation (P waves marching through)",
												"Fusion or capture beats",
												"Extremely wide QRS",
												"Concordance across precordial leads",
												"History of heart disease or channelopathy"
											]
										}
									}
								],
								"children": [
									{
										"label": "Stable + pulse",
										"node": {
											"id": "vt-stable",
											"label": "Expert Consultation",
											"type": "urgent",
											"description": "Amiodarone 5 mg/kg IV over 20-60 min. Cardiology consult.",
											"panels": [
												{
													"label": "Amiodarone",
													"type": "list",
													"content": {
														"items": [
															"Amiodarone 5 mg/kg IV over 20-60 minutes (max 300 mg)",
															"Monitor BP and rhythm continuously during infusion",
															"May repeat up to max 15 mg/kg/day",
															"Prepare for cardioversion if deteriorates",
															"DO NOT give amiodarone + procainamide together (both prolong QT)"
														]
													}
												}
											]
										}
									},
									{
										"label": "Unstable or pulseless",
										"node": {
											"id": "vt-unstable",
											"label": "Cardioversion / Defibrillation",
											"type": "emergency",
											"description": "Synchronized 0.5-1 J/kg if pulse. Unsynchronized 2 J/kg if pulseless."
										}
									}
								]
							}
						}
					]
				}
			}
		]
	}
}