	"root": {
		"id": "brady-id",
		"label": "Bradycardia with Pulse",
		"type": "assessment",
		"description": "HR <60 in infant, HR <age-appropriate lower limit in child",
		"panels": [
			{
				"label": "Normal HR by Age",
				"type": "table",
				"content": {
					"headers": [
						"Age",
						"Normal HR",
						"Bradycardia"
					],
					"rows": [
						[
							"Neonate",
							"100-180",
							"<100"
						],
						[
							"Infant",
							"100-160",
							"<100"
						],
						[
							"Toddler (1-3y)",
							"90-150",
							"<80"
						],
						[
							"Child (4-12y)",
							"70-120",
							"<60"
						],
						[
							"Adolescent",
							"55-100",
							"<50"
						]
					]
				}
			}
		],
		"children": [
			{
				"label": "Assess perfusion",
				"node": {
					"id": "perfusion",
					"label": "Cardiopulmonary Compromise?",
					"type": "decision",
					"description": "Hypotension, altered consciousness, signs of shock?",
					"children": [
						{
							"label": "Adequate perfusion",
							"node": {
								"id": "supportive",
								"label": "Supportive Care",
								"type": "action",
								"description": "Ensure airway, ventilation, O₂. Monitor. Identify cause.",
								"panels": [
									{
										"label": "Common Causes",
										"type": "list",
										"content": {
											"items": [
												"Hypoxia (most common — treat first)",
												"Hypothermia",
												"Head injury / raised ICP",
												"Drug effects (beta-blockers, calcium channel blockers, digoxin)",
												"Electrolyte abnormalities (hyperkalemia)",
												"Heart block (congenital or acquired)"
											]
										}
									}
								]
							}
						},
						{
							"label": "Poor perfusion / hemodynamically unstable",
							"node": {
								"id": "ventilate",
								"label": "VENTILATION + OXYGENATION",
								"type": "emergency",
								"description": "Support ventilation with 100% O₂. This is the priority.",
								"panels": [
									{
										"label": "Key Principle",
										"type": "alert",
										"content": {
											"severity": "emergency",
											"title": "Ventilation is the #1 intervention for pediatric bradycardia",
											"body": "Most pediatric bradycardia is caused by HYPOXIA. Effective ventilation and oxygenation will resolve the majority of bradycardic episodes without medication. Always ventilate first."
										}
									}
								],
								"children": [
									{
										"label": "HR still <60 with poor perfusion",
										"node": {
											"id": "cpr",
											"label": "Start CPR",
											"type": "emergency",
											"description": "If HR <60 despite adequate ventilation → begin compressions",
											"children": [
												{
													"label": "Medications",
													"node": {
														"id": "meds",
														"label": "Epinephrine",
														"type": "emergency",
														"description": "0.01 mg/kg IV/IO q3-5 min",
														"wasmCompute": [
															{
																"fn": "calculateDose",
																"args": [
																	"epinephrine"
																],
																"displayKey": "epiDose",
																"format": "dose"
															}
														],
														"panels": [
															{
																"label": "Medications",
																"type": "table",
																"content": {
																	"headers": [
																		"Agent",
																		"Dose",
																		"Notes"
																	],
																	"rows": [
																		[
																			"Epinephrine",
																			"0.01 mg/kg IV/IO (max 1 mg)",
																			"Repeat q3-5 min"
																		],
																		[
																			"Atropine",
																			"0.02 mg/kg IV/IO (min 0.1 mg, max 0.5 mg)",
																			"For increased vagal tone or AV block"
																		]
																	]
																}
															}
														],
														"children": [
															{
																"label": "Response",
																"node": {
																	"id": "responsive",
																	"label": "Post-Resuscitation",
																	"type": "stable",
																	"description": "Identify and treat underlying cause. Consider pacing."
																}
															},
															{
																"label": "No response",
																"node": {
																	"id": "pacing",
																	"label": "Consider Pacing",
																	"type": "urgent",
																	"description": "Transcutaneous pacing for complete heart block or sinus node dysfunction unresponsive to meds.",
																	"panels": [
																		{
																			"label": "Pacing",
																			"type": "list",
																			"content": {
																				"items": [
																					"Transcutaneous pacing for: complete heart block, sinus node dysfunction",
																					"NOT effective for asystole or hypoxia-driven bradycardia",
																					"Set rate to age-appropriate norm",
																					"Start at 2x threshold, titrate to capture",
																					"Sedate the patient — pacing is painful",
																					"Arrange emergent cardiology consultation and transfer"
																				]
																			}
																		}
																	]
																}
															}
														]
													}
												}
											]
										}
									}
								]
							}
						}
					]
				}
			}
		]
	}
