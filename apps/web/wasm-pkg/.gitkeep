# This directory holds the compiled ped-wasm WebAssembly package.
# Built automatically by GitHub Actions (.github/workflows/build-wasm.yml)
# when Rust source in crates/ changes.
#
# To build locally:
#   wasm-pack build --target web --out-dir apps/web/wasm-pkg --release crates/ped-wasm
#
# Required tools:
#   rustup target add wasm32-unknown-unknown
#   cargo install wasm-pack
