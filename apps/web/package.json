{
	"name": "pediatric-ed-cds-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:wasm": "echo '→ Cargo will pull rust-sci-core from GitHub on first build' && cd ../../crates/ped-wasm && wasm-pack build --target web --out-dir ../../apps/web/wasm-pkg",
		"build:all": "npm run build:wasm && npm run build",
		"build:wasm:release": "cd ../../crates/ped-wasm && wasm-pack build --target web --release --out-dir ../../apps/web/wasm-pkg",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint ."
	},
	"dependencies": {
		"d3-axis": "^3.0.0",
		"d3-force": "^3.0.0",
		"d3-geo": "^3.1.0",
		"d3-hierarchy": "^3.1.2",
		"d3-scale": "^4.0.2",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"d3-transition": "^3.0.1",
		"maplibre-gl": "^4.0.0",
		"svelte-maplibre": "^0.9.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-selection": "^3.0.11",
		"@types/d3-shape": "^3.1.8",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"eslint": "^10.1.0",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"svelte": "^4.2.0",
		"svelte-check": "^3.6.0",
		"typescript": "^5.3.0",
		"vite": "^5.0.0",
		"vite-plugin-top-level-await": "^1.4.0",
		"vite-plugin-wasm": "^3.3.0"
	}
}
