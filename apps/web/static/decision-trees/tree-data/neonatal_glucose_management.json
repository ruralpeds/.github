{
  "id": "neonatal-glucose-management",
  "title": "Neonatal Glucose Management — 32–35 Week Neonates",
  "subtitle": "Screening · Dextrose Gel · IV Dextrose · Escalation · Level II Nursery",
  "version": "1.0",
  "source": "AAP 2023 / Pediatrics 2023;151(1):e2022058941",
  "mode": "neonatal",
  "educationTopics": ["neonatal-glucose", "dextrose-gel", "hypoglycemia"],
  "root": {
    "id": "birth",
    "label": "Late Preterm Birth (32–35 wks)",
    "type": "assessment",
    "description": "Initiate glucose screening protocol",
    "panels": [
      {
        "label": "Protocol",
        "type": "text",
        "content": {
          "body": "All late preterm infants 32–35 wks GA should receive glucose screening starting at 30–60 min of life. Screen before each feed for first 24 hours. Target glucose ≥45 mg/dL (2.5 mmol/L) before feeds, ≥40 mg/dL in first 4 hours.",
          "source": "AAP Clinical Report 2023"
        }
      },
      {
        "label": "Risk Factors",
        "type": "list",
        "content": {
          "title": "Increased risk — screen more frequently:",
          "items": [
            "SGA or LGA (birth weight <10th or >90th percentile)",
            "IDM (Infant of Diabetic Mother)",
            "Perinatal stress or hypothermia",
            "Poor feeding ≥2 missed feeds",
            "Clinical symptoms: jitteriness, lethargy, poor tone"
          ]
        }
      }
    ],
    "children": [
      {
        "label": "Check glucose at 30–60 min",
        "node": {
          "id": "first-check",
          "label": "First Glucose Check",
          "type": "assessment",
          "description": "POC glucose at 30–60 min of life",
          "panels": [
            {
              "label": "Technique",
              "type": "text",
              "content": {
                "body": "Heel stick preferred. Warm heel 3–5 min prior. Use calibrated bedside glucometer. Confirm critical values (<25 or >250) with lab specimen if clinical picture warrants.",
                "source": "AAP NNP Competencies 2022"
              }
            }
          ],
          "children": [
            {
              "label": "Glucose < 25 mg/dL",
              "node": {
                "id": "critical-low",
                "label": "Critical Hypoglycemia",
                "type": "emergency",
                "description": "Glucose < 25 mg/dL — IV access required",
                "panels": [
                  {
                    "label": "Protocol",
                    "type": "list",
                    "content": {
                      "title": "Immediate actions:",
                      "items": [
                        "Establish IV access immediately",
                        "Mini-bolus D10W 2 mL/kg IV over 5 min",
                        "Start D10W at GIR 6–8 mg/kg/min",
                        "Recheck glucose in 30 minutes",
                        "Notify attending physician",
                        "Consider NICU consultation if refractory"
                      ],
                      "ordered": true
                    }
                  },
                  {
                    "label": "Dosing",
                    "type": "table",
                    "content": {
                      "headers": ["Weight", "Mini-bolus (2 mL/kg D10W)", "GIR 6 mg/kg/min rate"],
                      "rows": [
                        ["1.5 kg", "3 mL", "5.4 mL/hr"],
                        ["1.8 kg", "3.6 mL", "6.5 mL/hr"],
                        ["2.0 kg", "4 mL", "7.2 mL/hr"],
                        ["2.2 kg", "4.4 mL", "7.9 mL/hr"],
                        ["2.5 kg", "5 mL", "9.0 mL/hr"]
                      ],
                      "caption": "D10W mini-bolus and starting GIR at 6 mg/kg/min"
                    }
                  },
                  {
                    "label": "Alerts",
                    "type": "alert",
                    "content": {
                      "severity": "emergency",
                      "title": "Critical threshold",
                      "body": "Glucose < 25 mg/dL in a symptomatic infant requires IV glucose immediately. Do not delay for feed attempt. Confirm with lab glucose if clinical picture suggests error."
                    }
                  }
                ],
                "children": [
                  {
                    "label": "IV bolus + continuous infusion",
                    "node": {
                      "id": "iv-started",
                      "label": "IV D10W Started",
                      "type": "action",
                      "description": "Continuous D10W at GIR 6–8 mg/kg/min",
                      "children": [
                        {
                          "label": "Recheck glucose in 30 min",
                          "node": {
                            "id": "recheck-critical",
                            "label": "Recheck Glucose at 30 min",
                            "type": "assessment",
                            "children": [
                              {
                                "label": "≥ 45 mg/dL",
                                "node": {
                                  "id": "stabilized-after-iv",
                                  "label": "Glucose Stabilized",
                                  "type": "action",
                                  "description": "Continue GIR, begin oral feeds, wean gradually",
                                  "panels": [
                                    {
                                      "label": "Weaning",
                                      "type": "text",
                                      "content": {
                                        "body": "Begin oral/NG feeds. Wean GIR by 1–2 mg/kg/min q2–4h as glucose remains ≥45. Do not discontinue IV until oral feeds established and 2 consecutive pre-feed glucoses ≥45.",
                                        "source": "VON NIC/Q Glucose Protocol 2022"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "label": "Still < 45 mg/dL",
                                "node": {
                                  "id": "refractory",
                                  "label": "Refractory Hypoglycemia",
                                  "type": "emergency",
                                  "description": "Increase GIR, NICU consult",
                                  "panels": [
                                    {
                                      "label": "Protocol",
                                      "type": "list",
                                      "content": {
                                        "title": "Escalation steps:",
                                        "items": [
                                          "Increase GIR to 8–10 mg/kg/min (requires central access for >12.5% dextrose)",
                                          "Consider glucagon 0.03 mg/kg IM/IV (max 1 mg) if no IV access",
                                          "NICU transfer if GIR >12 or persistent despite treatment",
                                          "Endocrinology consult if hyperinsulinism suspected",
                                          "Work-up: insulin, cortisol, GH, free fatty acids, ketones"
                                        ],
                                        "ordered": true
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "label": "Glucose 25–44 mg/dL",
              "node": {
                "id": "low-asymptomatic",
                "label": "Low Glucose — Attempt Feed",
                "type": "urgent",
                "description": "25–44 mg/dL — feed first if asymptomatic",
                "panels": [
                  {
                    "label": "Protocol",
                    "type": "list",
                    "content": {
                      "title": "Management 25–44 mg/dL:",
                      "items": [
                        "If asymptomatic: offer breastfeeding or formula 10–15 mL/kg immediately",
                        "If cannot or will not feed: dextrose gel 0.5 mL/kg (200 mg/kg) buccal",
                        "Recheck glucose 30 min after feed/gel",
                        "If symptomatic (jittery, lethargy, seizure): go directly to IV"
                      ],
                      "ordered": true
                    }
                  },
                  {
                    "label": "Dextrose Gel",
                    "type": "table",
                    "content": {
                      "headers": ["Weight", "Dextrose Gel Dose (200 mg/kg = 0.5 mL/kg of 40% gel)"],
                      "rows": [
                        ["1.5 kg", "0.75 mL buccal"],
                        ["1.8 kg", "0.9 mL buccal"],
                        ["2.0 kg", "1.0 mL buccal"],
                        ["2.2 kg", "1.1 mL buccal"],
                        ["2.5 kg", "1.25 mL buccal"]
                      ],
                      "caption": "Dextrose gel 40% (Instaglucose) — massage into buccal mucosa"
                    }
                  },
                  {
                    "label": "Evidence",
                    "type": "text",
                    "content": {
                      "body": "Dextrose gel reduces NICU admission for hypoglycemia (NNT ~8), supports breastfeeding, and is non-inferior to IV glucose for asymptomatic hypoglycemia. Harris et al. Lancet 2013; ACOG/AAP updated guidance 2023.",
                      "source": "Harris DL et al. Lancet 2013;381(9875):1375–1383"
                    }
                  }
                ],
                "children": [
                  {
                    "label": "Recheck in 30 min",
                    "node": {
                      "id": "recheck-low",
                      "label": "Recheck After Feed/Gel",
                      "type": "assessment",
                      "children": [
                        {
                          "label": "≥ 45 mg/dL",
                          "node": {
                            "id": "responded-to-feed",
                            "label": "Responded to Feed/Gel",
                            "type": "action",
                            "description": "Continue feeds q2–3h, screen per protocol"
                          }
                        },
                        {
                          "label": "Still < 45 mg/dL",
                          "node": {
                            "id": "gel-failed",
                            "label": "Failed Feed/Gel",
                            "type": "urgent",
                            "description": "Escalate to IV glucose",
                            "children": [
                              {
                                "label": "Start IV D10W",
                                "node": {
                                  "id": "escalate-to-iv",
                                  "label": "Start IV D10W",
                                  "type": "action",
                                  "description": "GIR 6 mg/kg/min, recheck in 30 min"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "label": "Glucose 45–59 mg/dL",
              "node": {
                "id": "borderline",
                "label": "Borderline — Feed and Monitor",
                "type": "decision",
                "description": "Feed, recheck in 1–2 hours",
                "panels": [
                  {
                    "label": "Protocol",
                    "type": "text",
                    "content": {
                      "body": "Offer feed (breast or formula). Recheck pre-feed glucose in 1 hour. If drops below 45 at next screen, treat as 25–44 mg/dL. If ≥45 on 2 consecutive checks, extend screening interval to q3h.",
                      "source": "AAP Clinical Report 2023"
                    }
                  }
                ],
                "children": [
                  {
                    "label": "Feed → recheck at next feed",
                    "node": {
                      "id": "monitor-borderline",
                      "label": "Continue Feeds + Screen",
                      "type": "action",
                      "description": "Pre-feed glucose q2–3h for 24 hours"
                    }
                  }
                ]
              }
            },
            {
              "label": "Glucose ≥ 60 mg/dL",
              "node": {
                "id": "normal",
                "label": "Normal Glucose",
                "type": "action",
                "description": "Continue screening per protocol",
                "panels": [
                  {
                    "label": "Screening Schedule",
                    "type": "table",
                    "content": {
                      "headers": ["Time", "Screen interval"],
                      "rows": [
                        ["First 4 hours", "Before each feed (q1–2h)"],
                        ["Hours 4–12", "Before each feed (q2–3h)"],
                        ["Hours 12–24", "Pre-feed q3h if consistently ≥45"],
                        ["After 24h", "Discontinue if ≥45 on ≥2 consecutive checks and feeding well"]
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
