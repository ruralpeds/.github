{
  "id": "pediatric-cardiac-arrhythmia",
  "title": "Pediatric Cardiac Arrhythmia",
  "subtitle": "PALS 2025 Tachycardia & Bradycardia Algorithms",
  "version": "1.0",
  "source": "AHA/AAP PALS 2025",
  "mode": "pediatric",
  "root": {
    "id": "initial-assessment",
    "label": "Child with Tachycardia or Bradycardia",
    "type": "assessment",
    "description": "Initial cardiac rhythm assessment",
    "panels": [
      {
        "label": "Protocol",
        "type": "html",
        "content": {
          "html": "<h4>Initial Assessment (PALS 2025)</h4><ul><li>Maintain airway, support breathing, administer O₂</li><li>Attach cardiac monitor/defibrillator</li><li>Obtain 12-lead ECG when possible</li><li>Establish IV/IO access</li><li>Assess hemodynamic stability</li></ul>"
        }
      },
      {
        "label": "Dosing",
        "type": "html",
        "content": {
          "html": "<h4>Weight Estimation</h4><p>If weight unknown: Weight (kg) = (Age in years × 2) + 8</p><p>Always use measured weight when available.</p>"
        }
      },
      {
        "label": "Evidence",
        "type": "html",
        "content": {
          "html": "<h4>Source</h4><p>AHA/AAP Part 8: PALS 2025 Guidelines. Circulation 2025;151(Suppl 1). DOI: 10.1161/CIR.0000000000001368</p>"
        }
      }
    ],
    "children": [
      {
        "label": "Tachycardia\n(HR above normal)",
        "node": {
          "id": "tachycardia",
          "label": "TACHYCARDIA",
          "type": "decision",
          "description": "HR above normal for age",
          "panels": [
            {
              "label": "Protocol",
              "type": "html",
              "content": {
                "html": "<h4>Rate Thresholds</h4><ul><li>Infant: suspect SVT if HR >220 bpm</li><li>Child: suspect SVT if HR >180 bpm</li><li>Assess QRS width: ≤0.09s = narrow; >0.09s = wide</li></ul>"
              }
            },
            {
              "label": "Evidence",
              "type": "html",
              "content": {
                "html": "<p>PALS Tachycardia Algorithm 2025. AHA/AAP Guidelines.</p>"
              }
            }
          ],
          "children": [
            {
              "label": "Narrow QRS\n(≤0.09 sec)",
              "node": {
                "id": "narrow-qrs",
                "label": "Narrow QRS (≤0.09 sec)",
                "type": "assessment",
                "description": "Supraventricular origin",
                "children": [
                  {
                    "label": "Unstable",
                    "node": {
                      "id": "narrow-unstable",
                      "label": "Hemodynamically UNSTABLE",
                      "type": "emergency",
                      "description": "Hypotension, altered mental status, shock",
                      "panels": [
                        {
                          "label": "Protocol",
                          "type": "html",
                          "content": {
                            "html": "<h4>Signs of Instability</h4><ul><li>Hypotension for age</li><li>Altered mental status</li><li>Signs of shock (cool, mottled, poor pulses)</li><li>Signs of CHF (hepatomegaly, pulmonary edema)</li></ul><div class='bx br'>🚨 <strong>Act immediately.</strong> Do not delay treatment for diagnosis.</div>"
                          }
                        },
                        {
                          "label": "Dosing",
                          "type": "html",
                          "content": {
                            "html": "<h4>Synchronized Cardioversion</h4><p>1st: <strong>0.5-1 J/kg</strong></p><p>2nd: <strong>2 J/kg</strong></p><p>Sedate if time permits (ketamine 1-2 mg/kg IV or midazolam 0.1 mg/kg IV)</p>"
                          }
                        }
                      ],
                      "children": [
                        {
                          "label": "Immediate",
                          "node": {
                            "id": "narrow-cardiovert",
                            "label": "Synchronized Cardioversion",
                            "type": "emergency",
                            "description": "0.5-1 J/kg → 2 J/kg",
                            "panels": [
                              {
                                "label": "Protocol",
                                "type": "html",
                                "content": {
                                  "html": "<div class='bx br'>Ensure defibrillator is in SYNC mode. Verify sync markers on R waves before shocking.</div><h4>If cardioversion fails:</h4><ul><li>Re-attempt at higher energy</li><li>Consider adenosine if IV available</li><li>Consider amiodarone 5 mg/kg IV over 20-60 min</li></ul>"
                                }
                              },
                              {
                                "label": "Dosing",
                                "type": "html",
                                "content": {
                                  "html": "<h4>Energy Doses</h4><p>1st shock: <strong>0.5-1 J/kg</strong></p><p>2nd shock: <strong>2 J/kg</strong></p><p>If converting to arrest: switch to defibrillation <strong>2 J/kg → 4 J/kg</strong></p>"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "label": "Stable",
                    "node": {
                      "id": "narrow-stable",
                      "label": "Hemodynamically STABLE",
                      "type": "decision",
                      "description": "Determine SVT vs sinus tachycardia",
                      "children": [
                        {
                          "label": "Probable SVT\n(abrupt, fixed rate)",
                          "node": {
                            "id": "svt",
                            "label": "Probable SVT",
                            "type": "diagnosis",
                            "description": "Abrupt onset, fixed rate, no P waves",
                            "children": [
                              {
                                "label": "First-line",
                                "node": {
                                  "id": "vagal",
                                  "label": "Vagal Maneuvers",
                                  "type": "action",
                                  "description": "Infant: ice to face; Child: Valsalva",
                                  "panels": [
                                    {
                                      "label": "Protocol",
                                      "type": "html",
                                      "content": {
                                        "html": "<h4>Vagal Maneuver Techniques</h4><ul><li><strong>Infant:</strong> Ice bag/cold wet cloth to forehead, eyes, bridge of nose × 15-20 sec</li><li><strong>Child:</strong> Bear down / blow through straw / modified Valsalva</li><li><strong>Adolescent:</strong> Valsalva or carotid sinus massage (one side only)</li></ul><div class='bx br'>Do NOT use ocular pressure. Do NOT use carotid massage in infants.</div>"
                                      }
                                    },
                                    {
                                      "label": "Evidence",
                                      "type": "html",
                                      "content": {
                                        "html": "<p>Abbasi E, et al. Can Fam Physician 2024;70(2):113-115. PMC10949262.</p>"
                                      }
                                    }
                                  ],
                                  "children": [
                                    {
                                      "label": "If no\nconversion",
                                      "node": {
                                        "id": "adenosine",
                                        "label": "Adenosine",
                                        "type": "action",
                                        "description": "0.1 mg/kg (max 6mg) → 0.2 mg/kg (max 12mg)",
                                        "panels": [
                                          {
                                            "label": "Protocol",
                                            "type": "html",
                                            "content": {
                                              "html": "<h4>Adenosine Administration</h4><ul><li>Rapid IV push via largest, most proximal IV</li><li>Follow immediately with 5-10 mL NS flush</li><li>Use stopcock/3-way technique</li><li>Record continuous rhythm strip during admin</li><li>Half-life <10 sec — must be FAST push</li></ul><div class='bx br'>If given slowly or via distal IV without flush, drug will be metabolized before reaching heart.</div>"
                                            }
                                          },
                                          {
                                            "label": "Dosing",
                                            "type": "html",
                                            "content": {
                                              "html": "<h4>Dosing</h4><p>1st dose: <strong>0.1 mg/kg</strong> (max 6 mg)</p><p>2nd dose: <strong>0.2 mg/kg</strong> (max 12 mg)</p><p>3rd dose: <strong>0.2 mg/kg</strong> (max 12 mg)</p>"
                                            }
                                          },
                                          {
                                            "label": "Evidence",
                                            "type": "html",
                                            "content": {
                                              "html": "<p>Randall MM, et al. Int J Emerg Med 2024;17:103. DOI:10.1186/s12245-024-00683-5</p><p>Krause U, et al. Children 2023;10(5):847. PMC10217455.</p>"
                                            }
                                          }
                                        ],
                                        "children": [
                                          {
                                            "label": "Converts",
                                            "node": {
                                              "id": "converts-sinus",
                                              "label": "Converts to Sinus",
                                              "type": "action",
                                              "description": "Obtain 12-lead ECG, look for WPW",
                                              "panels": [
                                                {
                                                  "label": "Protocol",
                                                  "type": "html",
                                                  "content": {
                                                    "html": "<h4>Post-conversion Workup</h4><ul><li>12-lead ECG in sinus rhythm (check for delta wave/short PR)</li><li>If WPW pattern: do NOT use digoxin for prophylaxis</li><li>Observe 4-6 hours minimum</li><li>Consult pediatric cardiology</li></ul>"
                                                  }
                                                }
                                              ]
                                            }
                                          },
                                          {
                                            "label": "Does NOT\nconvert",
                                            "node": {
                                              "id": "no-convert",
                                              "label": "Does NOT Convert",
                                              "type": "urgent",
                                              "description": "Consider atrial flutter → cardioversion 0.5-2 J/kg",
                                              "panels": [
                                                {
                                                  "label": "Protocol",
                                                  "type": "html",
                                                  "content": {
                                                    "html": "<h4>Adenosine-Refractory Narrow Tachycardia</h4><ul><li>Adenosine will NOT terminate atrial flutter but WILL reveal F waves</li><li>Review rhythm strip during adenosine — look for sawtooth pattern</li><li>If atrial flutter confirmed: synchronized cardioversion 0.5-2 J/kg</li><li>If mechanism unclear: consult cardiology; consider procainamide or amiodarone</li></ul>"
                                                  }
                                                },
                                                {
                                                  "label": "Dosing",
                                                  "type": "html",
                                                  "content": {
                                                    "html": "<p>Procainamide: <strong>15 mg/kg IV over 30-60 min</strong></p><p>Amiodarone: <strong>5 mg/kg IV over 20-60 min</strong></p><p>Do NOT give both together.</p>"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "label": "Probable sinus\ntachycardia",
                          "node": {
                            "id": "sinus-tach",
                            "label": "Probable Sinus Tachycardia",
                            "type": "diagnosis",
                            "description": "Gradual onset, P waves, variable rate",
                            "children": [
                              {
                                "label": "Treat cause",
                                "node": {
                                  "id": "treat-cause",
                                  "label": "Treat Underlying Cause",
                                  "type": "action",
                                  "description": "Fever, pain, dehydration, anemia, sepsis"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "label": "Wide QRS\n(>0.09 sec)",
              "node": {
                "id": "wide-qrs",
                "label": "Wide QRS (>0.09 sec)",
                "type": "assessment",
                "description": "Assume VT until proven otherwise",
                "panels": [
                  {
                    "label": "Protocol",
                    "type": "html",
                    "content": {
                      "html": "<h4>Wide-Complex Tachycardia in Children</h4><ul><li>Assume VT until proven otherwise</li><li>May also be SVT with aberrancy or pre-excited SVT (WPW)</li><li>Expert consultation strongly recommended</li></ul><div class='bx br'>If WPW suspected: do NOT give adenosine, digoxin, verapamil, or diltiazem.</div>"
                    }
                  }
                ],
                "children": [
                  {
                    "label": "Unstable",
                    "node": {
                      "id": "wide-unstable",
                      "label": "Hemodynamically UNSTABLE",
                      "type": "emergency",
                      "description": "Immediate intervention required",
                      "children": [
                        {
                          "label": "Immediate",
                          "node": {
                            "id": "wide-cardiovert",
                            "label": "Synchronized Cardioversion",
                            "type": "emergency",
                            "description": "0.5-1 J/kg → 2 J/kg + expert consult"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "label": "Stable",
                    "node": {
                      "id": "wide-stable",
                      "label": "Hemodynamically STABLE",
                      "type": "decision",
                      "description": "Assess morphology",
                      "children": [
                        {
                          "label": "Regular +\nmonomorphic",
                          "node": {
                            "id": "monomorphic-vt",
                            "label": "Regular Monomorphic VT",
                            "type": "action",
                            "description": "Consider adenosine → amiodarone 5 mg/kg IV",
                            "panels": [
                              {
                                "label": "Protocol",
                                "type": "html",
                                "content": {
                                  "html": "<h4>Stable Wide-Complex Monomorphic VT</h4><ul><li>Adenosine may convert fascicular VT or RVOT VT</li><li>If adenosine fails: amiodarone or procainamide</li><li>Do NOT give amiodarone + procainamide together</li></ul>"
                                }
                              },
                              {
                                "label": "Dosing",
                                "type": "html",
                                "content": {
                                  "html": "<p>Amiodarone: <strong>5 mg/kg IV over 20-60 min</strong></p><p>Procainamide: <strong>15 mg/kg IV over 30-60 min</strong></p><p>Lidocaine: <strong>1 mg/kg IV bolus</strong> (alternative)</p>"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "label": "Irregular /\npolymorphic",
                          "node": {
                            "id": "torsades",
                            "label": "Torsades de Pointes",
                            "type": "emergency",
                            "description": "If QT prolonged: MgSO₄ 25-50 mg/kg",
                            "panels": [
                              {
                                "label": "Protocol",
                                "type": "html",
                                "content": {
                                  "html": "<h4>Torsades de Pointes</h4><div class='bx br'><strong>Do NOT give amiodarone, procainamide, or sotalol</strong> — these prolong QT and worsen TdP.</div><ul><li>IV Magnesium is the drug of choice</li><li>Correct K⁺ (target >4.0), Mg²⁺, Ca²⁺</li><li>Discontinue all QT-prolonging drugs</li><li>Consider overdrive pacing (90-110 bpm) if recurrent</li></ul>"
                                }
                              },
                              {
                                "label": "Dosing",
                                "type": "html",
                                "content": {
                                  "html": "<p>Magnesium sulfate: <strong>25-50 mg/kg IV (max 2g) over 10-20 min</strong></p><p>Isoproterenol: <strong>0.05-2 mcg/kg/min</strong> (bridge to pacing)</p>"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "label": "Bradycardia\n(HR <60, poor\nperfusion)",
        "node": {
          "id": "bradycardia",
          "label": "BRADYCARDIA",
          "type": "emergency",
          "description": "HR <60 with poor perfusion",
          "panels": [
            {
              "label": "Protocol",
              "type": "html",
              "content": {
                "html": "<h4>PALS Bradycardia Algorithm (2025)</h4><ul><li>If HR <60 bpm with poor perfusion despite adequate oxygenation and ventilation → start CPR</li><li>Epinephrine for persistent bradycardia during CPR</li><li>Atropine if increased vagal tone or primary AV block suspected</li></ul>"
              }
            },
            {
              "label": "Dosing",
              "type": "html",
              "content": {
                "html": "<h4>Medications</h4><p>Epinephrine: <strong>0.01 mg/kg IV/IO (1:10,000)</strong> every 3-5 min</p><p>Atropine: <strong>0.02 mg/kg IV/IO</strong> (min 0.1 mg, max 0.5 mg child)</p>"
              }
            }
          ],
          "children": [
            {
              "label": "Support ABCs",
              "node": {
                "id": "support-abcs",
                "label": "Support ABCs",
                "type": "action",
                "description": "Oxygenation & ventilation"
              }
            },
            {
              "label": "HR <60 +\npoor perfusion",
              "node": {
                "id": "start-cpr",
                "label": "Start CPR",
                "type": "emergency",
                "description": "If HR <60 with poor perfusion",
                "children": [
                  {
                    "label": "First-line",
                    "node": {
                      "id": "epi-brady",
                      "label": "Epinephrine",
                      "type": "emergency",
                      "description": "0.01 mg/kg IV/IO (1:10,000) q3-5 min"
                    }
                  },
                  {
                    "label": "If vagal\nor AV block",
                    "node": {
                      "id": "atropine",
                      "label": "Atropine",
                      "type": "action",
                      "description": "0.02 mg/kg IV/IO (min 0.1mg, max 0.5mg)"
                    }
                  }
                ]
              }
            },
            {
              "label": "Complete heart\nblock or refractory",
              "node": {
                "id": "pacing",
                "label": "Transcutaneous Pacing",
                "type": "emergency",
                "description": "If complete heart block or unresponsive to meds → TRANSPORT",
                "panels": [
                  {
                    "label": "Protocol",
                    "type": "html",
                    "content": {
                      "html": "<h4>Transcutaneous Pacing</h4><ul><li>Set rate: 100 bpm (infant), 80 bpm (child)</li><li>Increase mA until electrical capture</li><li>Provide sedation/analgesia</li><li>This is a bridge — arrange urgent transfer for transvenous or permanent pacing</li></ul>"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
